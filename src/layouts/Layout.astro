---
// src/layouts/Layout.astro — the paper page frame: sticky header, section nav with the black selection pill, footer.
import '../styles/paper.css';

interface Props {
  title: string;
  description?: string;
  /** The nav entry to mark as current on pages that are not the home page. */
  active?: string;
}

const {
  title,
  description = "Vittorio Pastore's personal website and portfolio showcasing robotics engineering projects and skills",
  active,
} = Astro.props;

const links = [
  { id: 'publications', label: 'Publications' },
  { id: 'projects', label: 'Projects' },
  { id: 'skills', label: 'Skills' },
  { id: 'activity', label: 'Activity' },
  { id: 'contact', label: 'Contact' },
];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <meta name="description" content={description} />
    <meta name="keywords" content="software engineer, full stack developer, AI, Reinforcement Learning, software development, portfolio" />
    <meta name="author" content="Vittorio Pastore" />

    <!-- Theme: the visitor's saved choice, otherwise the system's. Applied before first paint. -->
    <script is:inline>
      try {
        var saved = localStorage.getItem('paper-theme');
        var dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark-mode', dark);
      } catch (e) {}
    </script>
  </head>

  <body>
    <header class="site-header" id="site-header">
      <div class="wrap site-header-inner">
        <a class="brand" href="/" aria-label="Vittorio Pastore, home">
          <svg viewBox="0 0 64 64" aria-hidden="true">
            <rect width="64" height="64" rx="14" fill="var(--pill-bg)" />
            <path d="M14 19 L25 46 L36 19" stroke="var(--pill-fg)" stroke-width="7.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
            <rect x="41" y="42.5" width="12" height="7" rx="2.5" fill="var(--pill-fg)" />
          </svg>
        </a>

        <nav class="site-nav" id="site-nav" aria-label="Sections">
          {links.map(l => (
            <a href={`/#${l.id}`} data-nav={l.id} aria-current={active === l.id ? 'true' : undefined}>{l.label}</a>
          ))}
        </nav>

        <div class="header-actions">
          <button type="button" class="icon-btn" id="theme-toggle" aria-label="Switch between paper and dark">
            <svg class="theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4" />
            </svg>
            <svg class="theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
            </svg>
          </button>
          <button type="button" class="icon-btn" id="reboot-button" aria-label="Reboot" title="Restart the site from its boot menu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <path d="M12 3.5v8" />
              <path d="M6.8 6.8a7.5 7.5 0 1 0 10.4 0" />
            </svg>
          </button>
          <button type="button" class="icon-btn menu-btn" id="menu-toggle" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <path d="M4 8h16M4 16h16" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="wrap site-footer-inner">
        <span>Vittorio Pastore · {year}</span>
        <span class="footer-links">
          <a href="https://github.com/VittorioPastore/VittorioPastore.github.io">Source</a>
        </span>
      </div>
    </footer>

    <!-- Reboot overlay -->
    <div id="shutdown-overlay" class="shutdown-overlay" hidden>
      <pre id="shutdown-log"></pre>
      <p id="shutdown-status"></p>
      <p id="shutdown-subtext"></p>
    </div>

    <script>
      const html = document.documentElement;

      // Theme
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const dark = html.classList.toggle('dark-mode');
        try {
          localStorage.setItem('paper-theme', dark ? 'dark' : 'light');
        } catch (e) {}
      });
      // Until the visitor picks a theme, follow the system when it changes.
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', e => {
        let saved: string | null = null;
        try {
          saved = localStorage.getItem('paper-theme');
        } catch (err) {}
        if (!saved) html.classList.toggle('dark-mode', e.matches);
      });

      // Mobile menu
      const header = document.getElementById('site-header');
      const menuToggle = document.getElementById('menu-toggle');
      const setMenu = (open: boolean) => {
        header?.classList.toggle('menu-open', open);
        menuToggle?.setAttribute('aria-expanded', String(open));
      };
      menuToggle?.addEventListener('click', () => setMenu(!header?.classList.contains('menu-open')));
      document.querySelectorAll('#site-nav a').forEach(a => a.addEventListener('click', () => setMenu(false)));
      document.addEventListener('keydown', e => {
        if (e.key === 'Escape') setMenu(false);
      });

      // Section nav: the black pill marks the section in view (home page only; other pages set it in the markup).
      // A click on a section link moves it straight to the target and holds it there until the scroll comes to rest;
      // while scrolling by hand, a section takes the pill once the page has stayed in it for a moment.
      const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('#site-nav a[data-nav]'));
      const spied = navLinks
        .map(a => ({ a, el: document.getElementById(a.dataset.nav || '') }))
        .filter((s): s is { a: HTMLAnchorElement; el: HTMLElement } => !!s.el);

      if (spied.length > 0) {
        let shown: HTMLAnchorElement | null = null;
        let locked = false;
        let idle: ReturnType<typeof setTimeout> | undefined;
        let settle: ReturnType<typeof setTimeout> | undefined;
        let candidate: HTMLAnchorElement | null = null;

        const setCurrent = (current: HTMLAnchorElement | null) => {
          navLinks.forEach(a => (a === current ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
          shown = current;
        };
        const sectionInView = () => {
          const line = window.innerHeight * 0.4;
          let current: HTMLAnchorElement | null = null;
          for (const s of spied) if (s.el.getBoundingClientRect().top <= line) current = s.a;
          const atEnd = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 4;
          if (atEnd) current = spied[spied.length - 1].a;
          return current;
        };
        const sync = () => {
          const current = sectionInView();
          if (current !== shown) setCurrent(current);
        };

        document.addEventListener('click', e => {
          const a = (e.target as Element | null)?.closest?.('a[href*="#"]') as HTMLAnchorElement | null;
          if (!a) return;
          const url = new URL(a.href, window.location.href);
          if (url.pathname !== window.location.pathname || !url.hash) return;
          const target = spied.find(s => s.el.id === url.hash.slice(1));
          if (!target) return;
          locked = true;
          clearTimeout(settle);
          clearTimeout(idle);
          idle = setTimeout(() => { locked = false; sync(); }, 900); // in case no scroll follows
          setCurrent(target.a);
        });

        window.addEventListener(
          'scroll',
          () => {
            if (locked) {
              clearTimeout(idle);
              idle = setTimeout(() => { locked = false; sync(); }, 140);
              return;
            }
            const current = sectionInView();
            if (current === shown) {
              clearTimeout(settle);
              candidate = shown;
            } else if (current !== candidate) {
              candidate = current;
              clearTimeout(settle);
              settle = setTimeout(sync, 90);
            }
          },
          { passive: true },
        );
        sync();
      }

      // Reboot: a short power-cycle, then the boot menu.
      document.getElementById('reboot-button')?.addEventListener('click', async () => {
        const overlay = document.getElementById('shutdown-overlay');
        const log = document.getElementById('shutdown-log');
        const status = document.getElementById('shutdown-status');
        const sub = document.getElementById('shutdown-subtext');
        const wait = (ms: number) => new Promise(resolve => setTimeout(resolve, ms));

        if (overlay && log && status && sub) {
          const art = [
            '⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⢀⣀⣀⡀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀',
            '⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⢸⣿⣿⡇⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀',
            '⠀⠀⠀⠀⠀⠀⠀⠀⣀⣤⣶⡆⠀⢸⣿⣿⡇⠀⢰⣶⣤⣀⠀⠀⠀⠀⠀⠀⠀⠀',
            '⠀⠀⠀⠀⠀⠀⣤⣾⣿⣿⡿⠇⠀⢸⣿⣿⡇⠀⠸⢿⣿⣿⣷⣤⠀⠀⠀⠀⠀⠀',
            '⠀⠀⠀⠀⣠⣾⣿⣿⠟⠁⠀⠀⠀⢸⣿⣿⡇⠀⠀⠀⠈⠻⣿⣿⣷⣄⠀⠀⠀⠀',
            '⠀⠀⠀⢠⣿⣿⡟⠁⠀⠀⠀⠀⠀⢸⣿⣿⡇⠀⠀⠀⠀⠀⠈⢻⣿⣿⡄⠀⠀⠀',
            '⠀⠀⠀⣿⣿⡟⠀⠀⠀⠀⠀⠀⠀⠸⠿⠿⠇⠀⠀⠀⠀⠀⠀⠀⢻⣿⣿⠀⠀⠀',
            '⠀⠀⢸⣿⣿⠁⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠈⣿⣿⡇⠀⠀',
            '⠀⠀⢸⣿⣿⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⣿⣿⡇⠀⠀',
            '⠀⠀⠘⣿⣿⣇⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⣸⣿⣿⠃⠀⠀',
            '⠀⠀⠀⢹⣿⣿⣄⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⣠⣿⣿⡏⠀⠀⠀',
            '⠀⠀⠀⠀⢻⣿⣿⣦⡀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⢀⣴⣿⣿⡟⠀⠀⠀⠀',
            '⠀⠀⠀⠀⠀⠙⢿⣿⣿⣶⣤⣀⠀⠀⠀⠀⠀⠀⣀⣤⣶⣿⣿⡿⠋⠀⠀⠀⠀⠀',
            '⠀⠀⠀⠀⠀⠀⠀⠈⠛⢿⣿⣿⣿⣿⣶⣶⣿⣿⣿⣿⡿⠛⠁⠀⠀⠀⠀⠀⠀⠀',
            '⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠉⠉⠛⠛⠛⠛⠉⠉⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀',
          ];
          const colors = new Array(art.length).fill('var(--line-strong)');
          const render = () => {
            log.innerHTML = art.map((row, i) => `<span style="color:${colors[i]}">${row}</span>`).join('\n');
          };

          overlay.hidden = false;
          html.style.overflow = 'hidden';
          requestAnimationFrame(() => overlay.classList.add('is-on'));
          await wait(350);

          status.textContent = 'Initiating reboot sequence';
          sub.textContent = 'Stopping services';
          render();
          await wait(600);

          status.textContent = 'Powering down';
          sub.textContent = 'Unmounting filesystems';
          for (let i = 0; i < art.length; i++) {
            colors[i] = 'var(--ink)';
            render();
            await wait(50);
          }

          status.textContent = 'System halted';
          sub.textContent = 'Preparing for restart';
          await wait(800);

          status.textContent = 'Rebooting';
          sub.textContent = 'Starting kernel';
          for (let i = art.length - 1; i >= 0; i--) {
            colors[i] = 'var(--green)';
            render();
            await wait(26);
          }

          status.textContent = 'System online';
          sub.textContent = 'Welcome back';
          await wait(800);
        }

        sessionStorage.removeItem('hasBooted');
        sessionStorage.removeItem('safeGraphics');
        window.location.href = '/boot';
      });
    </script>
  </body>
</html>

<style is:global>
  .shutdown-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 24px;
    background: var(--paper);
    font-family: var(--mono);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .shutdown-overlay[hidden] { display: none; }
  .shutdown-overlay.is-on { opacity: 1; }
  #shutdown-log {
    margin: 0 0 20px;
    font-family: ui-monospace, Menlo, monospace;
    font-size: clamp(10px, 1.6vw, 14px);
    line-height: 1.15;
    text-align: center;
  }
  #shutdown-log span { transition: color 0.1s ease-in-out; }
  #shutdown-status { font-size: 0.9rem; font-weight: 500; color: var(--ink); min-height: 1.4em; }
  #shutdown-subtext {
    font-size: 0.68rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
    min-height: 1.4em;
  }
</style>
