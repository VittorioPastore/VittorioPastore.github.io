---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import ContributionGrid from '../components/ContributionGrid.astro';
import FunnyFeed from '../components/FunnyFeed';
import HeroStage from '../components/HeroStage.astro';
import TitleStage from '../components/TitleStage.astro';

const publications = [
  {
    title: 'A Nonlinear MPC Framework for Loco-Manipulation of Quadrupedal Robots with Non-Negligible Manipulator Dynamics',
    venue: 'IEEE RA-L',
    summary:
      'A real-time NMPC framework for quadrupedal loco-manipulation that couples simplified locomotion templates with full-order manipulator dynamics to effectively handle non-negligible arm mass.',
    href: 'https://arxiv.org/abs/2507.22042',
    posted: '2025-07-01', // arXiv 2507: July 2025
    cta: 'Read paper',
    figure: '/pub-nmpc.webp',
    figureAlt: 'A white quadruped robot mid-stride, carrying a robot arm on its back that reaches forward',
  },
  {
    title: 'ADMM-Based Distributed MPC with Control Barrier Functions for Safe Multi-Robot Quadrupedal Locomotion',
    venue: 'Under Review',
    summary:
      'A fully decentralized MPC framework using ADMM and control barrier functions to enable real-time, safe trajectory planning for multi-agent quadrupedal teams with significantly reduced computational overhead.',
    href: 'https://arxiv.org/abs/2603.19170',
    posted: '2026-03-01', // arXiv 2603: March 2026
    cta: 'Read paper',
    figure: '/pub-admm.webp',
    figureAlt: 'Three quadruped robots, each standing inside its own glowing amber safety ring on the floor',
  },
  {
    title: 'Multi-Agent Navigation via Distributed Consensus-Based Optimization and Learned Locomotion',
    venue: 'In Progress',
    summary:
      'A hierarchical control architecture for multi-agent legged navigation that integrates high-level distributed NMPC using ADMM for scalable collision avoidance with a low-level reinforcement learning policy for robust real-time locomotion.',
    href: null,
    cta: 'Coming soon',
    figure: '/pub-hier.webp',
    figureAlt: 'Three quadruped robots following dotted amber paths; two of them trade places on paths that bow around each other',
  },
  {
    title: "Master's Thesis",
    venue: 'VT Library',
    summary: 'Thesis research focused on multi agent locomotion via blending of classical and learning-based controls.',
    href: 'https://hdl.handle.net/10919/143475',
    cta: 'Read thesis',
    figure: '/pub-thesis.webp',
    figureAlt: 'Three small quadruped robots walking across the cover of a large hardback book',
  },
];

const skills = [
  { name: 'Python & C++', projects: ['humanoid-on-a-macbook', 'bones-seed-on-a-5070', 'squeaky-greyhound', 'neural-trader'] },
  { name: 'PyTorch & TensorFlow', projects: ['neural-trader'] },
  { name: 'ROS 2', projects: ['squeaky-greyhound'] },
  { name: 'Isaac Lab, MuJoCo & Raisim', projects: ['humanoid-on-a-macbook', 'bones-seed-on-a-5070', 'squeaky-greyhound'] },
  { name: 'Distributed NMPC', projects: ['controls-ios-application', 'nawcad'] },
  { name: 'Multi-Agent RL', projects: ['neural-trader'] },
  { name: 'Embodied AI', projects: ['mailclient'] },
  { name: 'MATLAB & Simulink', projects: ['nawcad', 'neural-trader'] },
  { name: 'Swift & Core ML', projects: ['mailclient', 'controls-ios-application'] },
  { name: 'Linux, Git & Docker', projects: [] },
];

const projects = {
  'humanoid-on-a-macbook': {
    title: 'Training a Humanoid on a MacBook',
    short: 'MLX humanoid',
    description: 'A world-model motion tracker ported from NVIDIA GPUs to MLX: 1,024 simulated Unitree G1s on an M1 Pro, and one policy that tracks 40 motion clips after 79 minutes.',
    skills: ['Python', 'MLX', 'MuJoCo', 'Reinforcement Learning'],
    href: '/humanoid-on-a-macbook',
    posted: '2026-11-13',
    // The card shows the render alone; the post has the full figure it comes from.
    image: '/mlx-humanoid-laptop.webp',
    imageSize: [1600, 1024],
    imageAlt: 'A crowd of small G1 humanoid robots moving across the keyboard of an open MacBook whose display shows a training curve',
  },
  'bones-seed-on-a-5070': {
    title: '131 Hours of Motion on an RTX 5070',
    short: 'BONES-SEED',
    description: 'The full 131-hour BONES-SEED motion library, trained on with one RTX 5070: a mid-range consumer GPU with 12 GB of memory, where the same run used to need 40 GB.',
    skills: ['Python', 'JAX', 'MuJoCo', 'Reinforcement Learning'],
    href: '/bones-seed-on-a-5070',
    posted: '2026-11-13',
    // The card shows the idea as a render; the post has the memory chart.
    image: '/bones-seed-gpu.webp',
    imageSize: [1600, 1024],
    imageAlt: 'A crowd of small G1 humanoid robots running, dancing and fighting across the top of a graphics card',
  },
  'squeaky-greyhound': {
    title: 'Squeaky and Greyhound',
    short: 'Squeaky & Greyhound',
    description: 'A 3D printed quadruped robot project featuring advanced inverse kinematics and a sleek mechanical design for enhanced mobility.',
    skills: ['Python', 'ROS', 'Raisim', 'C++'],
    href: '/squeaky-greyhound',
    posted: '2023-04-10',
  },
  'nawcad': {
    title: 'Senior Design: NAWCAD',
    short: 'NAWCAD',
    description: "Integrated test stand system design connecting mechanical engineering with a drone's flight stack using a custom Matlab GUI.",
    skills: ['Controls Theory', 'Matlab'],
    href: '/nawcad',
    posted: '2024-05-30',
  },
  'controls-ios-application': {
    title: 'Controls IOS Application',
    short: 'Controls iOS',
    description: "A personal project experimenting with PID control, Apple's Swift language, and custom UI design for simulating control systems.",
    skills: ['Controls Theory', 'Swift'],
    href: '/controls-ios-application',
    posted: '2025-04-10',
  },
  'mailclient': {
    title: 'Prysm Mail',
    short: 'Prysm Mail',
    description: 'A new type of email client leveraging local LLMs for enhanced privacy and user experience.',
    skills: ['Swift', 'CoreML', 'Embodied AI', 'Natural Language Processing'],
    href: '/mailclient',
    posted: '2025-08-04',
  },
  'neural-trader': {
    title: 'Neural Trader (AI Project)',
    short: 'Neural Trader',
    description: "A neural network based financial advisor built with Matlab's Neural Network Toolbox and Python for data scraping and analysis.",
    skills: ['Python', 'PyTorch', 'TensorFlow'],
    href: '/neural-trader',
    posted: '2025-04-10',
  },
  'website': {
    title: 'This Website',
    short: 'Website',
    description: 'How this site is put together: static pages built with Astro, robots drawn live in the browser, and one on the resume page that walks on inverse kinematics.',
    skills: ['Astro', 'TypeScript', 'three.js'],
    href: '/website',
    posted: '2025-04-11',
  },
};

// Projects that have a figure are featured, each as a full-width card; the others fill the grid below.
// A project is listed only once its page exists in src/pages, so a post that is not published yet stays off the site.
// The pages are globbed as raw text, only for their names: importing them as pages would pull every page's styles
// into this one.
const pages = import.meta.glob('./*.astro', { query: '?raw' });
const live = (id: string) => `./${id}.astro` in pages;
const all = Object.entries(projects).filter(([id]) => live(id)).map(([id, p]) => ({ id, ...p }));
const featured = all.filter(p => p.image);
const rest = all.filter(p => !p.image);

const num = (i: number) => String(i + 1).padStart(2, '0');
// The first card of the grid (the newest project) spans however many columns leave every row full.
const span = (cols: number) => ((1 - rest.length) % cols + cols) % cols || cols;
const leadSpans = `--s2: ${span(2)}; --s3: ${span(3)}; --s4: ${span(4)};`;
---

<Layout title="Vittorio Pastore - Portfolio">
  <main class="page">
    <!-- Hero: one screen. The name runs the full width of the page and the live robot stands in front of it. -->
    <section class="wrap hero">
      <h1 class="hero-name"><span>Vittorio</span> <span>Pastore</span></h1>
      <p class="hero-bio">
        Member of Technical Staff at Foundation.<br />
        Passionate about Reinforcement Learning, Music, and Photography.
      </p>
      <div class="btn-row hero-cta">
        <a class="btn primary" href="#projects">View projects</a>
        <a class="btn" href="/resume">Resume</a>
      </div>

      <HeroStage />
    </section>

    <div class="wrap stack">
      <!-- Work. Only what is already public: the role as on LinkedIn, and a video Foundation published itself. -->
      <section id="work">
        <div class="featured work">
          <div class="featured-text">
            <p class="kicker">Since May 2026</p>
            <h2 class="featured-title">Member of Technical Staff at Foundation</h2>
            <p class="card-text">
              Working on whole-body control for humanoid robots, in San Francisco.
            </p>
            <p class="meta">Before that: robotics research at Virginia Tech</p>
            <a class="go" href="https://foundation.bot">Foundation</a>
          </div>
          <figure class="fig">
            <div class="fig-frame video">
              <!-- Our own poster over Foundation's frame; a click swaps in the player. Without JavaScript it is a link. -->
              <a
                class="poster"
                href="https://www.youtube.com/watch?v=oRymQyooWjE"
                data-embed="https://www.youtube.com/embed/oRymQyooWjE?autoplay=1"
                aria-label="Play “How We Train Humanoid Robots”, a video by Foundation Robotics">
                <img src="https://i.ytimg.com/vi/oRymQyooWjE/maxres1.jpg" alt="" loading="lazy" />
                <span class="btn primary">Play</span>
              </a>
            </div>
          </figure>
        </div>
      </section>

      <!-- 01 Publications -->
      <section id="publications" class="zone">
        <header class="zone-head">
          <div>
            <p class="kicker">01</p>
            <TitleStage name="publications" title="Publications" />
          </div>
        </header>
        <div class="pub-grid">
          {publications.map(p => {
            const body = (
              <>
                <img class="pub-fig" src={p.figure} alt={p.figureAlt} width="1600" height="700" loading="lazy" />
                <p class="kicker pub-venue">
                  {p.posted && <span class="pill" data-posted={p.posted} hidden>New</span>}
                  {p.venue}
                </p>
                <h3>{p.title}</h3>
                <p class="card-text">{p.summary}</p>
                {p.href ? <span class="go">{p.cta}</span> : <span class="meta">{p.cta}</span>}
              </>
            );
            return p.href ? <a class="card pub" href={p.href}>{body}</a> : <article class="card pub">{body}</article>;
          })}
        </div>
      </section>

      <!-- 02 Projects -->
      <section id="projects" class="zone">
        <header class="zone-head">
          <div>
            <p class="kicker">02</p>
            <TitleStage name="projects" title="Projects" />
          </div>
        </header>

        {featured.map(f => (
          <a class="card featured" id={`project-${f.id}`} href={f.href}>
            <div class="featured-text">
              <span class="pill" data-posted={f.posted} hidden>New</span>
              <h3 class="featured-title">{f.title}</h3>
              <p class="card-text">{f.description}</p>
              <div class="tags">{f.skills.map(s => <span class="tag">{s}</span>)}</div>
              <span class="go">Read the post</span>
            </div>
            <img class="featured-fig" src={f.image} alt={f.imageAlt} width={f.imageSize[0]} height={f.imageSize[1]} loading="lazy" />
          </a>
        ))}

        <div class:list={['project-grid', { four: rest.length % 4 === 0 }]}>
          {rest.map((p, i) => (
            <a class:list={['card', 'project', { lead: i === 0 }]} id={`project-${p.id}`} href={p.href} style={i === 0 ? leadSpans : undefined}>
              <div class="project-inner">
                <div class="project-head">
                  <span class="pill" data-posted={p.posted} hidden>New</span>
                  <h3>{p.title}</h3>
                </div>
                <div class="project-body">
                  <p class="card-text">{p.description}</p>
                  <div class="tags">{p.skills.map(s => <span class="tag">{s}</span>)}</div>
                  <span class="go">View project</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- 03 Skills -->
      <section id="skills" class="zone">
        <header class="zone-head">
          <div>
            <p class="kicker">03</p>
            <TitleStage name="skills" title="Skills" />
          </div>
        </header>
        <div class="card skills">
          {skills.map((s, i) => (
            <div class="skill-row">
              <span class="meta">{num(i)}</span>
              <span class="skill-name">{s.name}</span>
              <span class="tags">
                {s.projects.filter(live).length > 0
                  ? s.projects.filter(live).map(id => <a class="tag" href={`#project-${id}`}>{projects[id].short}</a>)
                  : <span class="meta">everyday tooling</span>}
              </span>
            </div>
          ))}
        </div>
      </section>

      <!-- 04 Activity -->
      <section id="activity" class="zone">
        <header class="zone-head">
          <div>
            <p class="kicker">04</p>
            <TitleStage name="activity" title="Activity" />
          </div>
        </header>
        <div class="activity-grid">
          <ContributionGrid />
          <FunnyFeed client:visible />
        </div>
      </section>

      <!-- 05 Contact -->
      <section id="contact" class="zone contact">
        <div class="contact-lead">
          <p class="kicker">05 · Contact</p>
          <h2 class="contact-title">Get in<br />touch.</h2>
        </div>
        <div class="contact-cards">
          <a class="card contact-card" href="https://www.linkedin.com/in/vittorio-pastore-6474691b1/">
            <span class="kicker">LinkedIn</span>
            <span class="contact-value">Vittorio Pastore</span>
            <span class="go" aria-hidden="true"></span>
          </a>
          <a class="card contact-card" href="https://github.com/VittorioPastore">
            <span class="kicker">GitHub</span>
            <span class="contact-value">VittorioPastore</span>
            <span class="go" aria-hidden="true"></span>
          </a>
          <a class="card contact-card" href="mailto:vitto@vt.edu">
            <span class="kicker">Email</span>
            <span class="contact-value">vitto@vt.edu</span>
            <span class="go" aria-hidden="true"></span>
          </a>
        </div>
        <picture class="contact-photo">
          <source srcset="/vittoTransparent-900.webp 900w, /vittoTransparent-1800.webp 1800w" sizes="(min-width: 900px) 40vw, 90vw" type="image/webp" />
          <img src="/vittoTransparent.png" alt="Vittorio Pastore with robots" width="3516" height="3105" loading="lazy" />
        </picture>
      </section>
    </div>
  </main>
</Layout>

<script is:inline>
  // "New" shows only on papers and projects posted in the last 30 days, checked in the visitor's browser so it
  // expires on its own without a rebuild.
  document.querySelectorAll('.pill[data-posted]').forEach(function (pill) {
    var age = (Date.now() - Date.parse(pill.getAttribute('data-posted'))) / 86400000;
    if (age >= 0 && age <= 30) pill.hidden = false;
  });

  // The video poster: a plain click swaps it for the player; a modified click still opens the link.
  document.querySelectorAll('.poster[data-embed]').forEach(function (poster) {
    poster.addEventListener('click', function (event) {
      if (event.ctrlKey || event.metaKey || event.shiftKey) return;
      event.preventDefault();
      var frame = document.createElement('iframe');
      frame.src = poster.getAttribute('data-embed');
      frame.title = 'How We Train Humanoid Robots, a video by Foundation Robotics';
      frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      frame.allowFullscreen = true;
      poster.replaceWith(frame);
    });
  });
</script>

<style>
  /* ── Hero: one screen. The name is set as wide as the page; the stage sits over it, so the robot stands in front
     of the letters and its ghosts trail across them. Landscape: one line, the robot in the gap between the two
     words. Portrait: two lines, the stage tucked up under the second. ── */
  .hero {
    --hero-pad: clamp(14px, 3vh, 36px);
    --name-size: min(100cqw / 3.3, 16svh); /* "Pastore" is 3.2em wide; capped so a tall tablet still fits the buttons */
    container-type: inline-size;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    justify-items: center; /* stacked, everything under the name sits on the center line, as the robots do */
    text-align: center;
    gap: clamp(14px, 2.4vh, 26px);
    min-height: calc(100vh - var(--header-h));
    min-height: calc(100svh - var(--header-h));
    padding-block: var(--hero-pad);
  }

  .hero-name {
    font-size: var(--name-size);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.045em;
    margin-left: -0.045em; /* the V's side bearing: lines its stroke up with the page's left edge */
    justify-self: start; /* the name always hangs from the left */
    text-align: left;
    white-space: nowrap;
  }
  .hero-name span { display: block; }
  .hero-bio {
    position: relative;
    z-index: 2;
    order: 3;
    font-size: clamp(1rem, 0.92rem + 0.45vw, 1.3rem);
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 30rem;
    text-wrap: balance;
  }
  .hero-cta { position: relative; z-index: 2; order: 4; justify-content: center; }
  .hero :global(.stage) {
    order: 2;
    z-index: 1;
    margin-top: calc(var(--name-size) * -0.34);
    max-height: min(46svh, 38rem);
  }

  @media (min-width: 640px) and (min-aspect-ratio: 5 / 4) {
    .hero {
      --name-size: min(100cqw / 6.6, 30vh); /* the whole name is 6.5em wide */
      grid-template-columns: minmax(0, 3fr) minmax(0, 7fr);
      justify-items: start; /* side by side, the text hangs from the left edge */
      text-align: left;
    }
    .hero-name { grid-column: 1 / -1; }
    .hero-cta { justify-content: flex-start; }
    .hero-name span { display: inline; }
    .hero-bio { grid-column: 1 / -1; max-width: min(30rem, 37cqw); }
    .hero-cta { grid-column: 1; }
    /* The stage takes the right 70% at full height: its robot lands on the word space, its ghosts on "Pastore". */
    .hero :global(.stage) {
      position: absolute;
      inset: var(--hero-pad) 0 var(--hero-pad) auto;
      width: 70%;
      height: auto;
      margin: 0;
      aspect-ratio: auto;
      max-height: none;
    }
    /* Without WebGL the photo stands in: kept to the corner, so it does not cover the name. */
    .hero :global(.stage.is-failed) { top: auto; width: 44%; height: 58%; }
  }

  /* ── Section titles: the word as flat type with its robots live over it (TitleStage) ── */
  .zone-head > div { width: 100%; }

  /* ── Work: one card, the role beside the company's video ── */
  /* No zone and no card: the role and the video sit on the bare page, as the tail of the hero, inset like a zone's content. */
  #work { padding: 0 var(--zone-pad) var(--zone-pad); }
  /* Phones skip it: the hero bio already names the role, and the stacked poster is a long scroll for little. */
  @media (max-width: 639px) { #work { display: none; } }
  .featured.work { margin-bottom: 0; }
  /* The role's dates and what came before it are sentences about a person, not labels on a figure: they are set in
     the text face, as the bio above them is, and not in the code face of the kickers. */
  .work .kicker, .work .meta { font-family: var(--sans); font-size: 0.9rem; letter-spacing: 0; text-transform: none; }
  .work .fig { align-self: center; }
  .work .fig-frame { border: 0; background: none; } /* the poster is paper on paper: no frame around it */
  /* The frame is white type on black; inverted and multiplied onto the card it is ink on paper, as the hero is. */
  .poster { position: relative; display: block; height: 100%; }
  .poster img { width: 100%; height: 100%; object-fit: cover; filter: invert(1) grayscale(1) contrast(1.2); mix-blend-mode: multiply; }
  .poster .btn { position: absolute; right: 10px; bottom: 10px; min-height: 34px; padding: 0 16px; } /* clear of the figure */
  .poster:hover .btn { opacity: 0.85; }
  .poster:focus-visible { outline-offset: -4px; } /* the frame clips anything outside it */

  /* ── Publications ── */
  .pub-grid { display: grid; gap: var(--gap); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 760px) { .pub-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1500px) { .pub-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .pub { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  .pub h3 { text-wrap: pretty; }
  .pub-fig { display: block; width: 100%; height: auto; border-radius: 8px; margin-bottom: 4px; }
  .pub-venue { display: flex; align-items: center; gap: 8px; }
  .pub .card-text { flex: 1; }

  /* ── Projects ── */
  .featured { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--card-pad); align-items: center; margin-bottom: var(--gap); }
  .featured-text { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  .featured-title { font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.5rem); font-weight: 500; letter-spacing: -0.02em; line-height: 1.1; text-wrap: balance; }
  .featured .card-text { font-size: 1rem; max-width: 34rem; }
  .featured-fig { display: block; width: 100%; height: auto; border-radius: 8px; }
  @media (min-width: 900px) {
    .featured { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    /* The poster's art sits low in its frame (the top fifth is blank, the Play pill is at the bottom), so the text
       is pushed down to center on the art, not on the frame. */
    .work .featured-text { padding-top: 17%; }
  }
  /* One to four columns. The first card spans --s2 / --s3 / --s4 columns (set from the number of cards) so no
     row is left with a single stretched or orphaned card. */
  .project-grid { display: grid; gap: var(--gap); grid-template-columns: minmax(0, 1fr); }
  .project { container-type: inline-size; display: flex; }
  .project-inner { flex: 1; display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .project-head { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .project-body { flex: 1; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  .project .card-text { flex: 1; }
  @media (min-width: 600px) {
    .project-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .project.lead { grid-column: span var(--s2); }
  }
  @media (min-width: 900px) {
    .project-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .project.lead { grid-column: span var(--s3); }
  }
  @media (min-width: 1400px) {
    .project-grid.four { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .project-grid.four .project.lead { grid-column: span var(--s4); }
  }
  /* A card wide enough to be a row of its own puts its title beside its text. */
  @container (min-width: 720px) {
    .project-inner { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--card-pad); align-items: start; }
    .project-head h3 { font-size: clamp(1.3rem, 1rem + 1vw, 1.8rem); letter-spacing: -0.015em; line-height: 1.15; text-wrap: balance; }
  }
  .card:target { border-color: var(--ink); outline: 1px solid var(--ink); }

  /* ── Skills: a two-column table on wide screens ── */
  .skills { padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); overflow: hidden; }
  .skill-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: 7px 14px;
    padding: 13px var(--card-pad) 14px;
