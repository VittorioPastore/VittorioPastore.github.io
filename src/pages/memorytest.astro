---
// src/pages/memorytest.astro — memtest86+ inspired memory card game
import '../styles/tokens.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Memtest86+ v7.0 — Memory Test</title>
    <meta name="description" content="Memory card matching game — memtest86+ style" />
    <script is:inline>
      try {
        if (localStorage.getItem('paper-theme') === 'dark') document.documentElement.classList.add('dark-mode');
      } catch (e) {}
    </script>
  </head>
  <body>
    <div id="app">
      <!-- Header bar mimicking memtest86+ -->
      <header id="header">
        <div class="header-left">
          <span class="brand">Memtest86+ v7.0</span>
          <span class="sep">|</span>
          <span class="info" id="cpu-info">CPU: Portfolio Edition @ 3.6GHz</span>
        </div>
        <div class="header-right">
          <span id="timer">Time: 00:00</span>
          <span class="sep">|</span>
          <span id="moves">Moves: 0</span>
          <span class="sep">|</span>
          <span id="pairs-found">Pairs: 0/8</span>
        </div>
      </header>

      <!-- Stats bar -->
      <div id="stats-bar">
        <div class="stat">
          <span class="stat-label">Test:</span>
          <span class="stat-val" id="test-name">Concentration [Matching Pairs]</span>
        </div>
        <div class="stat">
          <span class="stat-label">Pass:</span>
          <span class="stat-val" id="pass-count">0</span>
        </div>
        <div class="stat">
          <span class="stat-label">Errors:</span>
          <span class="stat-val" id="error-count">0</span>
        </div>
        <div class="stat progress-stat">
          <span class="stat-label">Progress:</span>
          <div class="progress-bar">
            <div class="progress-fill" id="progress-fill"></div>
          </div>
          <span class="stat-val" id="progress-pct">0%</span>
        </div>
      </div>

      <!-- Difficulty selector -->
      <div id="difficulty-select">
        <span class="diff-label">Grid size:</span>
        <button class="diff-btn active" data-pairs="8" data-cols="4">4×4</button>
        <button class="diff-btn" data-pairs="12" data-cols="6">4×6</button>
        <button class="diff-btn" data-pairs="18" data-cols="6">6×6</button>
      </div>

      <!-- Game grid -->
      <div id="game-grid" class="grid-4"></div>

      <!-- Win screen -->
      <div id="win-screen" style="display:none;">
        <pre id="win-ascii"></pre>
        <p id="win-stats"></p>
        <div class="win-actions">
          <button id="play-again" class="action-btn">[Play Again]</button>
          <a href="/" class="action-btn" id="back-home">[Boot to Portfolio]</a>
        </div>
      </div>

      <!-- Footer -->
      <footer>
        <span>ESC: <a href="/">Exit to Portfolio</a></span>
        <span>|</span>
        <span>R: Restart</span>
      </footer>
    </div>

    <style is:global>
      *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
      html {
        background: var(--paper);
        color: var(--ink-2);
        font-family: var(--mono);
        font-size: 15px;
        line-height: 1.45;
      }
      body { min-height: 100vh; min-height: 100svh; display: flex; justify-content: center; }
      #app {
        width: min(100% - 2 * var(--gutter), 1100px);
        padding: var(--gap) 0;
        display: flex;
        flex-direction: column;
        gap: var(--gap);
        min-height: 100vh;
        min-height: 100svh;
      }
      a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 3px; }
      a:hover { text-decoration-color: var(--ink); }

      /* Header */
      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.4rem 1rem;
        background: var(--zone);
        border-radius: var(--r-card);
        color: var(--ink);
        padding: 0.7rem 1rem;
        font-size: 0.85rem;
      }
      .header-left, .header-right { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
      .sep { color: var(--line-strong); }
      .brand { color: var(--ink); font-weight: 500; }

      /* Stats bar */
      #stats-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        border: 1px solid var(--line);
        border-radius: var(--r-card);
        padding: 0.6rem 1rem;
        font-size: 0.85rem;
      }
      .stat { display: flex; align-items: center; gap: 0.4rem; }
      .stat-label { color: var(--muted); }
      .stat-val { color: var(--ink); font-weight: 500; }
      .progress-stat { flex: 1; min-width: 180px; }
      .progress-bar {
        flex: 1;
        max-width: 220px;
        height: 8px;
        background: var(--zone);
        border-radius: 999px;
        overflow: hidden;
      }
      .progress-fill { height: 100%; width: 0%; background: var(--green); border-radius: 999px; transition: width 0.3s; }

      /* Difficulty */
      #difficulty-select { display: flex; align-items: center; gap: 0.4rem; font-size: 0.85rem; }
      .diff-label { color: var(--muted); margin-right: 0.3rem; }
      .diff-btn {
        background: var(--card);
        color: var(--ink-2);
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 0.3rem 0.9rem;
        font-family: inherit;
        font-size: 0.85rem;
        cursor: pointer;
      }
      .diff-btn:hover { border-color: var(--ink); color: var(--ink); }
      .diff-btn.active { background: var(--pill-bg); color: var(--pill-fg); border-color: var(--pill-bg); }

      /* Game grid: sized to fit the screen in either orientation */
      #game-grid {
        display: grid;
        gap: clamp(5px, 1vmin, 10px);
        justify-content: center;
        align-content: center;
        margin: 0 auto;
        width: 100%;
        flex: 1;
      }
      .grid-4 { grid-template-columns: repeat(4, 1fr); max-width: min(100%, 62vh, 620px); }
      .grid-6 { grid-template-columns: repeat(6, 1fr); max-width: min(100%, 92vh, 900px); }

      /* Cards */
      .card {
        aspect-ratio: 1;
        border: 1px solid var(--line);
        border-radius: var(--r-card);
        background: var(--zone);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: clamp(1.4rem, 5vmin, 2.6rem);
        user-select: none;
        -webkit-tap-highlight-color: transparent;
        transition: background 0.15s, border-color 0.15s;
        position: relative;
      }
      .card::before { content: '?'; color: var(--faint); font-size: clamp(1.1rem, 3.6vmin, 1.8rem); }
      .card.flipped, .card.matched { background: var(--card); border-color: var(--ink); }
      .card.flipped::before, .card.matched::before { display: none; }
      .card .card-face { display: none; }
      .card.flipped .card-face, .card.matched .card-face { display: block; }
      .card.matched { border-color: var(--green); }
      .card.matched .card-face { opacity: 0.65; }
      .card.wrong { border-color: var(--danger); }
      .card:hover:not(.flipped):not(.matched) { border-color: var(--line-strong); background: var(--zone-2); }

      /* Win screen */
      #win-screen {
        text-align: center;
        padding: 2rem 1rem;
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
      }
      #win-ascii {
        color: var(--ink);
        font-family: ui-monospace, Menlo, Consolas, monospace;
        font-size: clamp(8px, 2vw, 15px);
        line-height: 1.2;
        margin-bottom: 1.5rem;
        text-align: left;
      }
      #win-stats { color: var(--ink); font-size: 0.95rem; margin-bottom: 1.5rem; }
      .win-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: center; }
      .action-btn {
        color: var(--ink);
        border: 1px solid var(--line-strong);
        border-radius: 999px;
        background: var(--card);
        padding: 0.55rem 1.3rem;
        font-family: inherit;
        font-size: 0.9rem;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
      }
      .action-btn:hover { border-color: var(--ink); }

      /* Footer */
      footer {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        justify-content: center;
        color: var(--muted);
        font-size: 0.8rem;
        padding-top: 0.75rem;
        border-top: 1px solid var(--line);
        margin-top: auto;
      }
      footer a { color: var(--muted); }
    </style>

    <script>
      // --- Card symbols ---
      const allSymbols = [
        '🧠','🔬','🤖','🚀','⚡','🔧','💾','🎯',
        '🧬','📡','🎮','🖥️','🔑','🛸','🌌','🎵',
        '📐','🦾'
      ];

      let totalPairs = 8;
      let gridCols = 4;
      let cards: { symbol: string; id: number }[] = [];
      let flippedCards: HTMLElement[] = [];
      let matchedCount = 0;
      let moveCount = 0;
      let errorCount = 0;
      let passCount = 0;
      let locked = false;
      let timerInterval: ReturnType<typeof setInterval> | null = null;
      let secondsElapsed = 0;
      let gameStarted = false;

      const grid = document.getElementById('game-grid')!;
      const timerEl = document.getElementById('timer')!;
      const movesEl = document.getElementById('moves')!;
      const pairsEl = document.getElementById('pairs-found')!;
      const errorEl = document.getElementById('error-count')!;
      const passEl = document.getElementById('pass-count')!;
      const progressFill = document.getElementById('progress-fill')!;
      const progressPct = document.getElementById('progress-pct')!;
      const winScreen = document.getElementById('win-screen')!;
      const winAscii = document.getElementById('win-ascii')!;
      const winStats = document.getElementById('win-stats')!;

      // Difficulty buttons
      document.querySelectorAll('.diff-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.diff-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          totalPairs = parseInt(btn.getAttribute('data-pairs')!);
          gridCols = parseInt(btn.getAttribute('data-cols')!);
          initGame();
        });
      });

      document.getElementById('play-again')!.addEventListener('click', () => initGame());

      // Keyboard shortcuts
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          sessionStorage.removeItem('hasBooted');
          window.location.href = '/boot';
        }
        if (e.key === 'r' || e.key === 'R') {
          initGame();
        }
      });

      // Clear boot flag when going home
      document.getElementById('back-home')?.addEventListener('click', () => {
        sessionStorage.removeItem('hasBooted');
      });

      function shuffle<T>(arr: T[]): T[] {
        const a = [...arr];
        for (let i = a.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [a[i], a[j]] = [a[j], a[i]];
        }
        return a;
      }

      function initGame() {
        // Reset state
        if (timerInterval) clearInterval(timerInterval);
        timerInterval = null;
        secondsElapsed = 0;
        moveCount = 0;
        matchedCount = 0;
        errorCount = 0;
        flippedCards = [];
        locked = false;
        gameStarted = false;

        updateUI();
        timerEl.textContent = 'Time: 00:00';

        // Pick random symbols
        const symbols = shuffle(allSymbols).slice(0, totalPairs);
        cards = shuffle([...symbols, ...symbols].map((s, i) => ({ symbol: s, id: i })));

        // Update grid class
        grid.className = gridCols <= 4 ? 'grid-4' : 'grid-6';
        grid.innerHTML = '';
        winScreen.style.display = 'none';
        grid.style.display = 'grid';

        cards.forEach((card, idx) => {
          const el = document.createElement('div');
          el.className = 'card';
          el.dataset.idx = String(idx);
          el.dataset.symbol = card.symbol;

          const face = document.createElement('span');
          face.className = 'card-face';
          face.textContent = card.symbol;
          el.appendChild(face);

          el.addEventListener('click', () => onCardClick(el));
          grid.appendChild(el);
        });

        // Update pairs display
        pairsEl.textContent = `Pairs: 0/${totalPairs}`;
      }

      function onCardClick(el: HTMLElement) {
        if (locked) return;
        if (el.classList.contains('flipped') || el.classList.contains('matched')) return;

        // Start timer on first click
        if (!gameStarted) {
          gameStarted = true;
          timerInterval = setInterval(() => {
            secondsElapsed++;
            const m = String(Math.floor(secondsElapsed / 60)).padStart(2, '0');
            const s = String(secondsElapsed % 60).padStart(2, '0');
            timerEl.textContent = `Time: ${m}:${s}`;
          }, 1000);
        }

        el.classList.add('flipped');
        flippedCards.push(el);

        if (flippedCards.length === 2) {
          moveCount++;
          locked = true;

          const [a, b] = flippedCards;
          if (a.dataset.symbol === b.dataset.symbol) {
            // Match!
            matchedCount++;
            a.classList.add('matched');
            b.classList.add('matched');
            flippedCards = [];
            locked = false;
            updateUI();

            if (matchedCount === totalPairs) {
              onWin();
            }
          } else {
            // No match
            errorCount++;
            a.classList.add('wrong');
            b.classList.add('wrong');
            updateUI();
            setTimeout(() => {
              a.classList.remove('flipped', 'wrong');
              b.classList.remove('flipped', 'wrong');
              flippedCards = [];
              locked = false;
            }, 700);
          }
        }
      }

      function updateUI() {
        movesEl.textContent = `Moves: ${moveCount}`;
        pairsEl.textContent = `Pairs: ${matchedCount}/${totalPairs}`;
        errorEl.textContent = String(errorCount);
        const pct = totalPairs > 0 ? Math.round((matchedCount / totalPairs) * 100) : 0;
        progressFill.style.width = `${pct}%`;
        progressPct.textContent = `${pct}%`;
      }

      function onWin() {
        if (timerInterval) clearInterval(timerInterval);
        passCount++;
        passEl.textContent = String(passCount);

        const m = String(Math.floor(secondsElapsed / 60)).padStart(2, '0');
        const s = String(secondsElapsed % 60).padStart(2, '0');
        const accuracy = moveCount > 0 ? Math.round((totalPairs / moveCount) * 100) : 100;
        let rating = 'S+';
        if (accuracy < 40) rating = 'C';
        else if (accuracy < 55) rating = 'B';
        else if (accuracy < 70) rating = 'A';
        else if (accuracy < 90) rating = 'S';

        winAscii.textContent =
`╔════════════════════════════════════════╗
║                                        ║
║         ████  ████  ████  ████         ║
║         █  █  █  █  █     █            ║
║         ████  ████  ████  ████         ║
║         █     █  █     █     █         ║
║         █     █  █  ████  ████         ║
║                                        ║
║   M E M O R Y   T E S T   P A S S E D  ║
║                                        ║
╚════════════════════════════════════════╝`;

        winStats.innerHTML =
          `Time: ${m}:${s} &nbsp;|&nbsp; Moves: ${moveCount} &nbsp;|&nbsp; Errors: ${errorCount} &nbsp;|&nbsp; Accuracy: ${accuracy}% &nbsp;|&nbsp; Rating: <span style="color:var(--green)">${rating}</span>`;

        // Brief delay, then show win screen
        setTimeout(() => {
          grid.style.display = 'none';
          winScreen.style.display = 'flex';
        }, 600);
      }

      // Initialize
      initGame();
    </script>
  </body>
</html>
