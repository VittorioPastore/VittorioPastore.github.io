---
// HeroStage.astro — the live hero: a humanoid rendered in the browser (three.js), playing rollouts of the policy
// trained on a MacBook (run mlx_lafan1_2h, iteration 4,750). The model and motions are baked into /g1-hero.glb.
// The robot is white, faces the visitor, and stands directly on the page: there is no backdrop. The translucent
// orange figures to its side are its own next poses. If WebGL is unavailable the photo is shown instead.
const clips = [
  { id: 'dance', label: 'Dance' },
  { id: 'run', label: 'Run' },
  { id: 'fight', label: 'Fight' },
  { id: 'fallAndGetUp', label: 'Get up' },
];
---

<div class="stage" id="hero-stage">
  <canvas
    id="hero-canvas"
    role="img"
    aria-label="A simulated white humanoid robot dancing, running, fighting and getting up, driven by a policy trained on a MacBook. Three translucent orange figures beside it show its next poses. Motions: LAFAN1 clips, Ubisoft La Forge."
  ></canvas>

  <picture class="stage-fallback">
    <source srcset="/vittoTransparent-900.webp 900w, /vittoTransparent-1800.webp 1800w" sizes="(min-width: 900px) 50vw, 100vw" type="image/webp" />
    <img src="/vittoTransparent.png" alt="Vittorio Pastore with robots" width="3516" height="3105" loading="lazy" />
  </picture>

  <div class="clips" role="group" aria-label="Motion">
    {clips.map((c, i) => (
      <button type="button" data-clip={c.id} aria-pressed={i === 0 ? 'true' : 'false'}>{c.label}</button>
    ))}
  </div>
</div>

<style>
  .stage {
    position: relative;
    width: 100%;
    min-width: 0;
    aspect-ratio: 5 / 4;
    max-height: min(66svh, 38rem);
  }
  @media (min-width: 640px) and (min-aspect-ratio: 5 / 4) {
    .stage { aspect-ratio: 4 / 3; max-height: calc(100svh - var(--header-h) - 2 * var(--hero-pad)); }
  }

  /* The canvas edges are feathered, so the floor's light and shadow never end in a visible rectangle. */
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 0.8s ease;
    touch-action: pan-y; /* a sideways drag turns the view; an up-and-down swipe still scrolls the page */
    cursor: grab;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent), linear-gradient(to bottom, #000 82%, transparent 97%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent), linear-gradient(to bottom, #000 82%, transparent 97%);
    mask-composite: intersect;
  }
  .stage.is-live canvas { opacity: 1; }
  .stage.is-dragging canvas { cursor: grabbing; }

  .stage-fallback { display: none; }
  .stage.is-failed canvas, .stage.is-failed .clips { display: none; }
  .stage.is-failed .stage-fallback { display: flex; position: absolute; inset: 0; }
  .stage-fallback img { width: 100%; height: 100%; object-fit: contain; object-position: center bottom; }

  /* Motion picker: the black pill is the selection, as everywhere else. */
  .clips {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    display: flex;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--card);
  }
  .clips button {
    font: 500 0.84rem/1 var(--sans);
    color: var(--muted);
    background: none;
    border: 0;
    border-radius: 999px;
    padding: 8px 14px;
    min-height: 34px;
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.15s, background-color 0.15s;
  }
  .clips button:hover { color: var(--ink); }
  .clips button[aria-pressed='true'] { background: var(--pill-bg); color: var(--pill-fg); }
</style>

<script>
  const stage = document.getElementById('hero-stage');
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('#hero-stage .clips button'));
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  async function start() {
    if (!stage || !canvas) return;
    const THREE = await import('three');
    const { GLTFLoader } = await import('three/examples/jsm/loaders/GLTFLoader.js');
    const { RoomEnvironment } = await import('three/examples/jsm/environments/RoomEnvironment.js');

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true, powerPreference: 'high-performance' });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFShadowMap;
    renderer.toneMapping = THREE.NeutralToneMapping; // keeps the white shell white

    const scene = new THREE.Scene();
    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture; // soft reflections on the shell
    pmrem.dispose();

    // The robot stands at the origin and its next poses are laid out beside it, along +x: to the right on screen.
    const GHOSTS = 3;
    const SPACING = 0.4; // meters between one figure and the next
    const LEAD = 0.18; // seconds between one figure and the next
    const camera = new THREE.PerspectiveCamera(24, 1, 0.1, 60);
    const target = new THREE.Vector3((GHOSTS * SPACING) / 2, 0.6, 0); // its height is set with the framing, below

    // Studio lighting: a broad soft fill, a key from the front that casts the shadow, and a rim from behind that
    // outlines the body.
    const fill = new THREE.HemisphereLight(0xffffff, 0xc9ccd2, 1.1);
    // A directional key: its shadow map covers the whole visible floor, so the map's edge never shows as a line.
    const key = new THREE.DirectionalLight(0xfff4ea, 1.9);
    key.position.set(1.4, 4.6, 3.4);
    key.target.position.copy(target);
    key.castShadow = true;
    key.shadow.mapSize.set(2048, 2048);
    key.shadow.camera.left = key.shadow.camera.bottom = -5;
    key.shadow.camera.right = key.shadow.camera.top = 5;
    key.shadow.camera.near = 0.5;
    key.shadow.camera.far = 16;
    key.shadow.bias = -0.0005;
    key.shadow.radius = 5;
    const rim = new THREE.DirectionalLight(0xcfe0ff, 0.9);
    rim.position.set(-3.2, 2.8, -3.4);
    scene.add(fill, key, key.target, rim);

    // Floor: the robot's shadow and a soft pool of tone under the figures. The pool fades out with distance, so the
    // floor dissolves into the page instead of ending at the canvas edge.
    const shadowMat = new THREE.ShadowMaterial({ opacity: 0.26, depthWrite: false });
    const floor = new THREE.Mesh(new THREE.PlaneGeometry(9, 7), shadowMat);
    floor.rotation.x = -Math.PI / 2;
    floor.receiveShadow = true;
    floor.position.set(target.x, -0.02, 0); // just under the soles, so a limb resting on the ground is never drawn over
    floor.renderOrder = -2; // floor layers draw first, in this order, and never hide one another
    scene.add(floor);

    const poolMat = new THREE.ShaderMaterial({
      transparent: true,
      depthWrite: false,
      uniforms: { uColor: { value: new THREE.Color() }, uOpacity: { value: 1 } },
      vertexShader: `
        varying vec2 vUv;
        void main() {
          vUv = uv;
          gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
        }`,
      fragmentShader: `
        uniform vec3 uColor;
        uniform float uOpacity;
        varying vec2 vUv;
        void main() {
          float fade = 1.0 - smoothstep(0.0, 1.0, length(vUv - 0.5) * 2.0);
          float a = uOpacity * fade * fade;
          if (a < 0.002) discard;
          gl_FragColor = vec4(uColor, a);
          #include <colorspace_fragment>
        }`,
    });
    const pool = new THREE.Mesh(new THREE.PlaneGeometry(6.4, 4.4), poolMat); // an ellipse, wider than deep
    pool.rotation.x = -Math.PI / 2;
    pool.position.set(target.x, -0.02, 0);
    pool.renderOrder = -1;
    scene.add(pool);

    // Load the robot. It sits in a group that turns it, so a new motion can start facing the way the last one ended.
    const gltf = await new GLTFLoader().loadAsync('/g1-hero.glb');
    const shell = new THREE.MeshPhysicalMaterial({ color: 0xf3f3f1, metalness: 0, roughness: 0.36, clearcoat: 0.5, clearcoatRoughness: 0.3 });
    const darkPart = new THREE.MeshStandardMaterial({ color: 0x33363b, metalness: 0.2, roughness: 0.45 });
    const visor = new THREE.MeshStandardMaterial({ color: 0x1b1d20, metalness: 0.3, roughness: 0.25 }); // the ring around the face
    gltf.scene.traverse(o => {
      const mesh = o as InstanceType<typeof THREE.Mesh>;
      if (mesh.isMesh) {
        const kind = (mesh.material as InstanceType<typeof THREE.Material>).name;
        mesh.material = kind === 'glow' ? visor : kind === 'dark' ? darkPart : shell;
        mesh.castShadow = true;
        mesh.frustumCulled = false; // bounds are those of the quantized mesh, not of its animated pose
      }
    });

    // Motions. Each clip carries the path its root traveled (removed from the motion when it was baked); the figures
    // stay in place, so that track is dropped.
    const yawOf = (q: { x: number; y: number; z: number; w: number }) => Math.atan2(2 * (q.w * q.z + q.x * q.y), 1 - 2 * (q.y * q.y + q.z * q.z));
    const wrap = (a: number) => Math.atan2(Math.sin(a), Math.cos(a));
    const rootName = (() => {
      let name = '';
      gltf.scene.traverse(o => {
        if (!name && /pelvis$/i.test(o.name)) name = o.name;
      });
      return name;
    })();
    if (!rootName) throw new Error('root body not found');
    type Clip = { name: string; anim: InstanceType<typeof THREE.AnimationClip>; duration: number; yaw0: number };
    const clipsByName = new Map<string, Clip>();
    for (const anim of gltf.animations) {
      const ti = anim.tracks.findIndex(t => t.name.startsWith('track.'));
      if (ti >= 0) anim.tracks.splice(ti, 1);
      const rot = anim.tracks.find(t => t.name === `${rootName}.quaternion`);
      const q = rot ? rot.values : [0, 0, 0, 1];
      clipsByName.set(anim.name, { name: anim.name, anim, duration: anim.duration, yaw0: yawOf({ x: q[0], y: q[1], z: q[2], w: q[3] }) });
    }
    const order = buttons.map(b => b.dataset.clip || '').filter(n => clipsByName.has(n));

    const FADE = 0.9; // seconds of blending from one motion into the next
    const HOME_YAW = 0.1; // where the camera sits when nobody is dragging it: just right of straight ahead
    // Heading the robot is held near. At heading 0 its front points along +x, to the right on screen; a quarter turn
    // back from there it points at the home camera, so it faces the visitor.
    const FACING = HOME_YAW - Math.PI / 2;

    // A figure: one copy of the model with its own clock. The robot and each of its ghosts are figures running the
    // same motions; a ghost's clock is simply ahead of the robot's.
    type Figure = ReturnType<typeof makeFigure>;
    const makeFigure = (model: InstanceType<typeof THREE.Object3D>) => {
      const turn = new THREE.Group();
      turn.add(model);
      scene.add(turn);
      const root = model.getObjectByName(rootName)!;
      const mixer = new THREE.AnimationMixer(model);
      const actions = new Map<string, ReturnType<typeof mixer.clipAction>>();
      for (const c of clipsByName.values()) {
        const a = mixer.clipAction(c.anim);
        a.setLoop(THREE.LoopOnce, 1);
        a.clampWhenFinished = true;
        actions.set(c.name, a);
      }
      const fig = {
        turn,
        root,
        mixer,
        cur: null as Clip | null,
        clock: 0,
        turnYaw: 0,
        turning: null as { from: number; to: number; t: number } | null,
        retiring: [] as { clip: Clip; at: number }[],
        time: () => (fig.cur ? actions.get(fig.cur.name)!.time : 0),
        play(name: string) {
          const next = clipsByName.get(name);
          if (!next || next === fig.cur) return;
          const prev = fig.cur;
          const action = actions.get(name)!;
          action.reset().setEffectiveTimeScale(1).setEffectiveWeight(1).play();
          if (prev) {
            actions.get(prev.name)!.crossFadeTo(action, FADE, false);
            // Start the new motion facing the way the figure faces now, by turning the whole figure over the blend.
            const facing = fig.turnYaw + yawOf(root.quaternion);
            fig.turning = { from: fig.turnYaw, to: fig.turnYaw + wrap(facing - next.yaw0 - fig.turnYaw), t: 0 };
            fig.retiring.push({ clip: prev, at: fig.clock + FADE + 0.06 });
          } else {
            fig.turnYaw = FACING - next.yaw0;
          }
          fig.cur = next;
        },
        // Put this figure where `other` is now, mid-motion, with nothing else blending in.
        matchTo(other: Figure) {
          mixer.stopAllAction();
          fig.retiring = [];
          fig.cur = other.cur;
          fig.turnYaw = other.turnYaw;
          fig.turning = other.turning ? { ...other.turning } : null;
          if (fig.cur) {
            const a = actions.get(fig.cur.name)!;
            a.reset().setEffectiveTimeScale(1).setEffectiveWeight(1).play();
            a.time = other.time();
          }
          mixer.update(0);
        },
        advance(dt: number) {
          fig.clock += dt;
          mixer.update(dt);
          if (fig.turning) {
            fig.turning.t += dt;
            const p = Math.min(fig.turning.t / FADE, 1);
            fig.turnYaw = fig.turning.from + (fig.turning.to - fig.turning.from) * (p * p * (3 - 2 * p));
            if (p >= 1) fig.turning = null;
          }
          fig.retiring = fig.retiring.filter(r => {
            if (fig.clock < r.at) return true;
            if (fig.cur !== r.clip) actions.get(r.clip.name)!.stop();
            return false;
          });
          // Blend into the next motion a little before this one ends.
          if (fig.cur && fig.time() >= fig.cur.duration - FADE - 0.05 && order.length > 1) {
            fig.play(order[(order.indexOf(fig.cur.name) + 1) % order.length]);
          }
        },
      };
      return fig;
    };

    // The ghosts are copies of the model in one translucent orange each, fading out the further ahead they are.
    // Each is drawn as a single even layer: its shape goes into the depth buffer first, so only its nearest surface
    // is then colored, and limbs that cross do not add up into darker patches.
    const ghostShape = new THREE.MeshBasicMaterial({
      colorWrite: false,
      transparent: true, // so it is drawn after the robot, not before
      polygonOffset: true, // a hair behind the colored surface, so the two never fight over a pixel
      polygonOffsetFactor: 1,
      polygonOffsetUnits: 1,
    });
    const ghostMats: InstanceType<typeof THREE.MeshStandardMaterial>[] = [];
    const ghostModels = Array.from({ length: GHOSTS }, () => {
      const mat = new THREE.MeshStandardMaterial({ color: 0xff8a4d, emissive: 0xff8a4d, roughness: 0.7, metalness: 0, transparent: true, depthWrite: false });
      ghostMats.push(mat);
      const model = gltf.scene.clone(true);
      const meshes: InstanceType<typeof THREE.Mesh>[] = [];
      model.traverse(o => {
        if ((o as InstanceType<typeof THREE.Mesh>).isMesh) meshes.push(o as InstanceType<typeof THREE.Mesh>);
      });
      for (const mesh of meshes) {
        mesh.material = mat;
        mesh.castShadow = false;
        mesh.renderOrder = 1;
        const shape = new THREE.Mesh(mesh.geometry, ghostShape);
        shape.frustumCulled = false;
        mesh.add(shape); // renderOrder 0: before the color
      }
      return model;
    });
    const robot = makeFigure(gltf.scene);
    const ghosts = ghostModels.map((model, k) => {
      const g = makeFigure(model);
      g.turn.position.x = (k + 1) * SPACING;
      return g;
    });
    // A ghost's groups, which carry its place in the drawing order: the ghosts are drawn whole, farthest first.
    const ghostGroups = ghosts.map(g => {
      const groups: InstanceType<typeof THREE.Object3D>[] = [];
      g.turn.traverse(o => {
        if ((o as InstanceType<typeof THREE.Group>).isGroup) groups.push(o);
      });
      return groups;
    });

    // Light levels for a white robot on a white page, and the ghosts: a light wash of orange, each less than half
    // as solid as the one before.
    poolMat.uniforms.uColor.value.set('#5f6368');
    poolMat.uniforms.uOpacity.value = 0.1;
    renderer.toneMappingExposure = 1.05;
    scene.environmentIntensity = 0.7;
    ghostMats.forEach((m, k) => {
      m.emissiveIntensity = 0.3;
      m.opacity = 0.55 * 0.45 ** k;
    });

    // Starting a motion: the robot blends into it from where it is, and each ghost shows where that blend will be
    // a little later.
    const play = (name: string) => {
      if (!clipsByName.has(name) || robot.cur?.name === name) return;
      ghosts.forEach(g => g.matchTo(robot));
      [robot, ...ghosts].forEach((f, k) => {
        f.play(name);
        if (k > 0) f.advance(k * LEAD);
      });
    };
    buttons.forEach(b => b.addEventListener('click', () => play(b.dataset.clip || '')));

    // Camera: a slow sway, plus a little parallax from the pointer. Dragging the stage turns the view around the
    // figures; two seconds after the drag ends it eases back home.
    const HOME_AFTER = 2; // seconds
    const orbit = { yaw: 0, pitch: 0 }; // what dragging has added to the view
    let drag: { id: number; x: number; y: number } | null = null;
    let releasedAt = -Infinity; // on the stage's clock (`elapsed`)
    const endDrag = (e: PointerEvent) => {
      if (!drag || e.pointerId !== drag.id) return;
      drag = null;
      releasedAt = elapsed;
      orbit.yaw = wrap(orbit.yaw); // so the way home is the short way round
      stage.classList.remove('is-dragging');
    };
    canvas.addEventListener('pointerdown', e => {
      if (drag || (e.pointerType === 'mouse' && e.button !== 0)) return;
      drag = { id: e.pointerId, x: e.clientX, y: e.clientY };
      canvas.setPointerCapture(e.pointerId);
      stage.classList.add('is-dragging');
      if (e.pointerType === 'mouse') e.preventDefault(); // no text selection while dragging
    });
    canvas.addEventListener('pointermove', e => {
      if (!drag || e.pointerId !== drag.id) return;
      const perPixel = Math.PI / Math.max(stage.clientWidth, 1); // the stage's width is half a turn
      orbit.yaw -= (e.clientX - drag.x) * perPixel;
      orbit.pitch = Math.max(-0.04, Math.min(1.1, orbit.pitch + (e.clientY - drag.y) * perPixel)); // never under the floor
      drag.x = e.clientX;
      drag.y = e.clientY;
    });
    canvas.addEventListener('pointerup', endDrag);
    canvas.addEventListener('pointercancel', endDrag);

    let aim = { x: 0, y: 0 };
    const look = { x: 0, y: 0 };
    window.addEventListener('pointermove', e => {
      if (drag) return; // the view is in the visitor's hand
      const r = stage.getBoundingClientRect();
      aim = {
        x: Math.max(-1, Math.min(1, (e.clientX - (r.left + r.width / 2)) / (window.innerWidth / 2))),
        y: Math.max(-1, Math.min(1, (e.clientY - (r.top + r.height / 2)) / (window.innerHeight / 2))),
      };
    }, { passive: true });

    let distance = 5;
    const resize = () => {
      const w = stage.clientWidth;
      const h = stage.clientHeight;
      if (w === 0 || h === 0) return;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      // The floor sits just above the motion picker, with 1.6 m of room over it and, for the robot and its ghosts,
      // 2.4 m of width in frame.
      const picker = stage.querySelector<HTMLElement>('.clips');
      const below = picker ? Math.min((stage.getBoundingClientRect().bottom - picker.getBoundingClientRect().top + 12) / h, 0.4) : 0.1;
      const t = Math.tan((camera.fov * Math.PI) / 360);
      const tall = Math.max(1.6 / (1 - below), 2.4 / camera.aspect); // meters of height in frame
      distance = tall / (2 * t);
      target.y = tall * (0.5 - below);
      camera.updateProjectionMatrix();
    };
    new ResizeObserver(resize).observe(stage);
    resize();

    let elapsed = 0;
    let shown = ''; // the motion the picker marks as playing
    let steer = 0; // extra turn shared by all figures, which keeps the robot facing the visitor however its motion turns
    const frame = (dt: number) => {
      elapsed += dt;
      robot.advance(dt);
      ghosts.forEach(g => g.advance(dt));

      // Follow the robot's heading, a little behind it, and only while it is upright: lying down it has no heading.
      const q = robot.root.quaternion;
      const upright = Math.max(0, 1 - 2 * (q.x * q.x + q.y * q.y));
      steer += wrap(FACING - (robot.turnYaw + steer + yawOf(q))) * (1 - Math.exp(-4 * upright * upright * dt));
      robot.turn.rotation.y = robot.turnYaw + steer;
      ghosts.forEach(g => (g.turn.rotation.y = g.turnYaw + steer));
      if (robot.cur && robot.cur.name !== shown) {
        shown = robot.cur.name;
        buttons.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.clip === shown)));
      }

      look.x += (aim.x - look.x) * 0.06;
      look.y += (aim.y - look.y) * 0.06;
      if (!drag && elapsed - releasedAt > HOME_AFTER) {
        const ease = 1 - Math.exp(-3.5 * dt);
        orbit.yaw -= orbit.yaw * ease;
        orbit.pitch -= orbit.pitch * ease;
      }
      // Visitors who ask for reduced motion get a camera that only moves when they drag it; the robot itself still moves.
      const yaw = (calm ? HOME_YAW : HOME_YAW + Math.sin(elapsed * 0.16) * 0.12 - look.x * 0.25) + orbit.yaw;
      const pitch = (calm ? 0.06 : 0.06 + look.y * 0.05) + orbit.pitch;
      camera.position.set(
        target.x + Math.sin(yaw) * Math.cos(pitch) * distance,
        target.y + Math.sin(pitch) * distance,
        target.z + Math.cos(yaw) * Math.cos(pitch) * distance,
      );
      camera.lookAt(target);
      ghosts
        .map((g, k) => ({ k, d: g.turn.position.distanceToSquared(camera.position) }))
        .sort((a, b) => b.d - a.d)
        .forEach(({ k }, rank) => ghostGroups[k].forEach(o => (o.renderOrder = rank + 1)));
      renderer.render(scene, camera);
    };

    play(order[0]);
    // Render only while the stage is on screen and the tab is visible.
    let visible = true;
    let running = false;
    let lastT = 0;
    const loop = (now: number) => {
      if (!visible || document.hidden) {
        running = false;
        return;
      }
      // Never step backward: a frame's timestamp can be slightly earlier than the clock read that started the loop,
      // and a negative step makes a play-once motion finish (and freeze) at its first frame.
      frame(Math.min(Math.max((now - lastT) / 1000, 0), 0.05));
      lastT = now;
      requestAnimationFrame(loop);
    };
    const wake = () => {
      if (running || !visible || document.hidden) return;
      running = true;
      lastT = performance.now();
      requestAnimationFrame(loop);
    };
    new IntersectionObserver(entries => {
      visible = entries.some(e => e.isIntersecting);
      wake();
    }).observe(stage);
    document.addEventListener('visibilitychange', wake);

    frame(0);
    stage.classList.add('is-live');
    wake();
  }

  start().catch(err => {
    console.warn('Hero stage unavailable:', err);
    stage?.classList.add('is-failed');
  });
</script>
